###############################
# Agent Control server config #
###############################

# Server host/port
AGENT_CONTROL_HOST=0.0.0.0
AGENT_CONTROL_PORT=8000

###################
# Agent executor  #
###################

# An "executor" is the process that runs an agent. Agent Control never runs
# agent code: it opens a session on the executor, reads the conversation back,
# and applies its controls in between. Everything in this block is about
# talking to that other process.
#
# Off by default. While it is off, the chat endpoints answer 503 with a written
# message and nothing else changes, so an existing deployment is unaffected.
# AGENT_CONTROL_EXECUTOR_ENABLED=false

# READ THIS BEFORE ENABLING.
#
# 1. Turning this on requires AGENT_CONTROL_API_KEY_ENABLED=true. The server
#    refuses to start otherwise. With credential checks off every operation
#    succeeds unauthenticated, and after this feature that includes starting
#    turns that spend your model quota and putting text in front of a running
#    agent. AGENT_CONTROL_EXECUTOR_ALLOW_INSECURE_LOCAL_DEV=true opts out, and
#    is for a laptop, not a deployment.
#
# 2. Turning this on also refuses a wildcard AGENT_CONTROL_CORS_ORIGINS while
#    cookie auth is in use. Name the UI origin explicitly. "*" plus credentials
#    means any page in any tab can drive this API as the logged-in operator.
#
# 3. `adk api_server` ships with NO AUTHENTICATION. Publishing its port is
#    equivalent to publishing an unauthenticated, model-spending endpoint to
#    whoever finds it. Keep it on an internal network with no `ports:` mapping.
#    The shared secret below is defence in depth; ADK will not check it, so it
#    is not the control.
#
# 4. An agent with any HTTP-egress tool is an SSRF pivot onto the network its
#    own executor sits on, where that unauthenticated session API is reachable.
#    One executor process per agent shrinks the blast radius to that agent's own
#    sessions. Where agents have web access and more than one tenant exists, the
#    executor network must be unreachable from tool egress.
#
# 5. Under the default header auth provider, per-user isolation of transcripts
#    is NOT enforceable. Every browser caller resolves to the same identity, so
#    the per-caller scoping on transcript reads separates API keys and does not
#    separate two people using the console. A deployment with more than one real
#    tenant needs the upstream auth provider and per-namespace executors.

# Sent on every executor request. Defence in depth only; see note 3.
# AGENT_CONTROL_EXECUTOR_SHARED_SECRET="change-me"
# AGENT_CONTROL_EXECUTOR_SHARED_SECRET_HEADER="X-Agent-Control-Executor-Secret"

# Bounds one non-streaming executor call: session create, read, delete, health.
# AGENT_CONTROL_EXECUTOR_TIMEOUT_SECONDS=30

# Bounds one blocking turn. Separate from the number above because a session
# read taking thirty seconds is broken and a turn taking thirty seconds is
# ordinary.
#
# Passing this limit returns 504, and the wording of that 504 matters: the
# server stops waiting, the AGENT DOES NOT STOP. It keeps calling models and
# keeps spending until it finishes on its own. Its work turns up in the next
# transcript read.
# AGENT_CONTROL_EXECUTOR_TURN_TIMEOUT_SECONDS=300

# How long a turn lock may sit untouched before another turn may take it over.
# This is the only recovery path for a lock whose handler died without clearing
# it - a killed replica, an OOM - because there is no sweeper process; the
# predicate lives inside the statement that starts a turn.
#
# Must be greater than the turn timeout, and the server refuses to start
# otherwise. Set it lower and a live turn gets reclaimed while it is still
# running, so two invocations write one conversation: the exact outcome the
# lock exists to prevent, configured into happening.
# AGENT_CONTROL_EXECUTOR_TURN_STALE_AFTER_SECONDS=900

# Streaming bounds. Unused until the streaming turn route exists.
# AGENT_CONTROL_EXECUTOR_STREAM_IDLE_TIMEOUT_SECONDS=60
# AGENT_CONTROL_EXECUTOR_MAX_STREAM_SECONDS=900
# AGENT_CONTROL_EXECUTOR_MAX_CONCURRENT_STREAMS=8

# Cost ceilings. A turn is the first request in this product that spends money
# per call, and a per-session limit does not help when a caller can open more
# sessions.
# AGENT_CONTROL_EXECUTOR_MAX_TURNS_PER_MINUTE=30
# AGENT_CONTROL_EXECUTOR_MAX_CONCURRENT_SESSIONS=100

# Outbound connection-pool ceilings, shared across every executor this server
# talks to.
# AGENT_CONTROL_EXECUTOR_MAX_CONNECTIONS=32
# AGENT_CONTROL_EXECUTOR_MAX_KEEPALIVE_CONNECTIONS=8

# ---------------------------------------------------------------------------
# Attachments: files an operator attaches to a session.
#
# A second switch on top of the executor one, so a deployment can run chat
# without accepting files. While it is off the attachment routes answer 503
# with a written message.
# AGENT_CONTROL_EXECUTOR_ATTACHMENTS_ENABLED=false
#
# READ THIS BEFORE ENABLING.
#
# 1. Under the default header auth provider there is no per-user isolation of
#    attachments, for the same reason note 5 above gives for transcripts: every
#    browser caller resolves to the same identity. This separates API keys from
#    each other and separates nothing between two people using the console.
#    Real per-user isolation needs the upstream auth provider.
#
# 2. The bytes live in this server's Postgres as `bytea`. A large row TOASTs
#    out of line and lands in `pg_dump` and every base backup, so the quotas
#    below are not optional and the retention sweeps are what keep the total
#    from growing without bound.
#
# 3. Nothing here opens a document. The accepted set is decided by a magic-byte
#    sniff over the first sixteen bytes, so page counts and token estimates are
#    null and no ceiling below bounds either. Office formats are ZIP containers
#    and are refused; export a PDF.

# Exactly the types the sniffer can name and a model can use.
# AGENT_CONTROL_EXECUTOR_ATTACHMENT_ACCEPTED_MIMES='["application/pdf","image/png","image/jpeg","image/webp"]'

# Per-file ceiling. Twenty megabytes is a very large document, and the resident
# cost of one is twenty-seven once base64 inflates it during delivery. The hard
# constant the database CHECK carries is 52428800 and cannot be raised here.
# AGENT_CONTROL_EXECUTOR_ATTACHMENT_MAX_BYTES=20971520

# Delivery ceilings, checked before any blob is read.
# AGENT_CONTROL_EXECUTOR_ATTACHMENT_MAX_PER_TURN=3
# AGENT_CONTROL_EXECUTOR_ATTACHMENT_TURN_TOTAL_BYTES=20971520

# Storage ceilings. Bytes, because a byte is the only thing this server can
# measure without opening the file.
# AGENT_CONTROL_EXECUTOR_ATTACHMENT_MAX_PER_SESSION=10
# AGENT_CONTROL_EXECUTOR_ATTACHMENT_SESSION_TOTAL_BYTES=104857600
# AGENT_CONTROL_EXECUTOR_ATTACHMENT_NAMESPACE_TOTAL_BYTES=2147483648

# Rates. A stored-bytes ceiling is not a rate: upload flooding fills the
# namespace total in seconds and the retention window then holds it there.
# AGENT_CONTROL_EXECUTOR_ATTACHMENT_UPLOADS_PER_MINUTE=20
# AGENT_CONTROL_EXECUTOR_ATTACHMENT_UPLOADS_PER_NAMESPACE_HOUR=200

# Retention, run from the upload path. There is no sweeper daemon, so read the
# two windows below as "on the next upload attempt into this namespace after N",
# not "on a schedule". A namespace that stops uploading stops reclaiming, and
# nothing else in this server will ever run these. Both sweeps commit in a
# transaction of their own, so an upload refused by a quota still leaves behind
# whatever its own pressure reclaimed.
#
# The first reclaims uploads that were never bound to a turn - somebody
# attached a file and closed the tab - and deletes them whole.
#
# The second reclaims the bytes of attachments that were used and are now old,
# leaving a tombstone that keeps the name, size, hashes and origin. It is not
# tidiness: sessions belonging to a dispatch task persist by default, so the
# cascade that would reclaim their attachments may never fire, and without this
# the namespace ceiling is reachable with no action that clears it.
# AGENT_CONTROL_EXECUTOR_ATTACHMENT_ORPHAN_TTL_HOURS=72
# AGENT_CONTROL_EXECUTOR_ATTACHMENT_BLOB_TTL_DAYS=14

# The executor keeps its conversations in its own database, which must NOT be
# the Agent Control database: the test suite truncates every table it finds in
# this one, and Alembic autogenerate would try to drop the executor's. It also
# connects as its own Postgres role, not `agent_control`. `agent_control` owns
# the control plane, so an executor holding it could read and rewrite your
# `controls`, `policies` and `control_bindings` - an agent editing the
# guardrails that govern it, reachable through ordinary prompt injection into a
# tool result.
#
# docker-compose.dev.yml provisions both, in the one-shot `adk-db-init`
# service, which runs server/scripts/adk_db_init.sql. This is deliberately not
# a /docker-entrypoint-initdb.d script: the compose files mount a named pgdata
# volume and the Postgres image runs init scripts only against an empty data
# directory, so an existing install would silently never get any of it. Set the
# role's password with ADK_DB_PASSWORD in the environment compose reads. It is
# not an AGENT_CONTROL_ setting and must never reach the server: the control
# plane has no business holding the executor's credentials, or vice versa.
#
# Upgrading an existing Postgres by hand, or provisioning one this compose file
# does not manage, is the same file run against the maintenance database:
#   psql -v ON_ERROR_STOP=1 -h <host> -U <superuser> -d postgres \
#        -v adk_password='<password>' -f server/scripts/adk_db_init.sql
# Or, against a running compose stack:
#   docker compose exec -T postgres psql -v ON_ERROR_STOP=1 \
#        -U agent_control -d postgres -v adk_password='<password>' \
#        -f - < server/scripts/adk_db_init.sql
# It is idempotent and safe to re-run. It closes one control-plane database per
# run, so pass -v control_db=<name> and run it again for each additional one;
# a name that does not exist is skipped. docker-compose.dev.yml already does
# this for agent_control and the local pytest database agent_control_test,
# which carries the same schema.
#
# The compose job authenticates with AGENT_CONTROL_POSTGRES_PASSWORD, the same
# variable docker-compose.yml gives Postgres, so a customised password works
# without further setup.
#
# If you would rather do it by hand, this is the whole of it. Note the second
# REVOKE: `REVOKE CONNECT ... FROM adk` on its own does nothing, because
# Postgres grants are additive and CONNECT is granted to PUBLIC by default on
# every database, so the role keeps reaching the control plane through PUBLIC.
# Grant CONNECT explicitly to any other non-superuser login role first, or
# revoking it from PUBLIC will lock that role out too, and grant it to any
# non-superuser role you add later, which will no longer pick it up from PUBLIC.
#   CREATE ROLE adk LOGIN PASSWORD '...'
#       NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS NOINHERIT;
#   CREATE DATABASE adk_runtime OWNER adk;
#   REVOKE CONNECT ON DATABASE agent_control FROM adk;
#   REVOKE CONNECT ON DATABASE agent_control FROM PUBLIC;
# Then verify by attempting the connection, not by reading the SQL back:
#   PGPASSWORD='...' psql -h <host> -U adk -d agent_control -c 'select 1'
#   => FATAL: permission denied for database "agent_control"

################################
# API key authentication (auth) #
################################

# Master toggle for authentication (disabled by default for local dev).
# When set to true, API key auth is required for protected endpoints.
AGENT_CONTROL_API_KEY_ENABLED=false

# Comma-separated list of valid API keys for standard access.
# Example: "my-ui-key,my-sdk-key"
AGENT_CONTROL_API_KEYS="my-ui-key"

# OPTIONAL: comma-separated list of admin API keys (subset with elevated
# privileges). Only needed if you use admin-only routes; for most local
# testing a single AGENT_CONTROL_API_KEYS entry is enough.
AGENT_CONTROL_ADMIN_API_KEYS="my-admin-key"

# Secret used to sign session JWTs for browser logins.
# IMPORTANT: set this to a long, random, persistent value in production.
AGENT_CONTROL_SESSION_SECRET="change-me-to-a-long-random-string"

################
# CORS / UI dev #
################

# Allowed origins for CORS. When using the Next.js dev server on :4000,
# set this to the exact UI origin so cookie-based auth works cross-origin.
# Name the origins. Browser auth here is cookie-based, so requests are
# credentialed, and "*" with credentials means a page on any site can drive
# this API as whoever is logged in. Enabling the agent executor makes the
# server refuse to start with a wildcard, for exactly that reason.
AGENT_CONTROL_CORS_ORIGINS="http://localhost:4000"

#########################################
# Database (preferred AGENT_CONTROL_DB_) #
#########################################

# Preferred single-variable form:
AGENT_CONTROL_DB_URL=postgresql+psycopg://agent_control:agent_control@localhost:5432/agent_control

# Expanded PostgreSQL settings (legacy DB_* and DATABASE_URL are still accepted)
AGENT_CONTROL_DB_HOST=localhost
AGENT_CONTROL_DB_PORT=5432
AGENT_CONTROL_DB_USER=agent_control
AGENT_CONTROL_DB_PASSWORD=agent_control
AGENT_CONTROL_DB_DATABASE=agent_control

############################
# Linear milestones (opt-in) #
############################

# Personal API key used to read project milestones for teams that have a
# linear_team_key set. The key is used server-side only: it is never returned
# by an endpoint and never reaches the browser.
# Leaving it unset is supported - the milestones endpoint then reports
# status "not_configured" and no request is made to Linear.
# AGENT_CONTROL_LINEAR_API_KEY="lin_api_..."

# How long a successful read is reused before Linear is called again.
# AGENT_CONTROL_LINEAR_CACHE_TTL_SECONDS=60

# How long an expired read stays usable as a fallback while Linear is failing
# or rate-limiting. Set to 0 to always surface the error instead.
# AGENT_CONTROL_LINEAR_STALE_TTL_SECONDS=900

# Request timeout when calling Linear.
# AGENT_CONTROL_LINEAR_TIMEOUT_SECONDS=10

# How long to stop calling Linear after a failed read that carried no
# Retry-After, so an unreachable Linear does not cost a full timeout on every
# page view. A rate-limit response overrides this with the delay Linear asked
# for.
# AGENT_CONTROL_LINEAR_ERROR_COOLDOWN_SECONDS=30

###########
# Logging #
###########

# Log level for the server's own loggers (e.g. INFO, DEBUG, WARNING).
# AGENT_CONTROL_LOG_LEVEL=INFO

# Emit logs as JSON instead of plain text.
# AGENT_CONTROL_LOG_JSON=false

# Whether the server installs its own logging handlers. Set to false to let an
# embedding host own the logging configuration (passes log_config=None to uvicorn).
# AGENT_CONTROL_CONFIGURE_LOGGING=true

# Whether uvicorn's built-in per-request access log is emitted. Set to false to
# suppress it, e.g. when an embedding host already emits its own request log.
# AGENT_CONTROL_ACCESS_LOG=true


###########################
# Agent runtime configuration
###########################

# Per-agent system prompt and model, edited in the dashboard and picked up by a
# running agent within one refresh interval. Storage is always on. What the
# settings below control is the allowlist and whether a saved configuration
# reaches a running agent at all.

# The models an agent may be configured to run on. JSON array, empty by default,
# so the model half of the feature is inert until an operator opts in.
#
# `provider` selects which client the SDK constructs and is authoritative: the
# SDK never infers it from the id, because Google ADK's model registry picks a
# client class by matching the name and a bare `gpt-*` string resolves to one
# whose factory reads OPENAI_BASE_URL from the process, or reaches OpenAI when
# that is unset.
#
# THERE IS NO ENDPOINT FIELD, AND AN ID MAY NOT CONTAIN "/" OR "://". The server
# refuses to start on one that does. A slash prefix re-selects the underlying
# provider and the configured api_base is ignored for routing, so a slashed id
# is a per-agent endpoint by another name - it would send every prompt, tool
# result and piece of customer data to a host of the writer's choosing. The
# endpoint comes from the executor process's own environment; see
# AGENT_CONTROL_MODEL_BASE_URL below.
#
# `cost_tier` is one of economy, standard, premium. It is operator-authored
# banding shown as a badge; Agent Control prints no prices because it does not
# know them.
#
# AGENT_CONTROL_MODELS_ALLOWLIST='[
#   {"id":"gpt-5.4-mini","label":"GPT 5.4 mini","provider":"openai_compatible",
#    "cost_tier":"economy","recommended":true},
#   {"id":"gpt-5.6-sol","label":"GPT 5.6 Sol","provider":"openai_compatible",
#    "cost_tier":"premium"},
#   {"id":"gemini-2.5-flash","label":"Gemini 2.5 Flash","provider":"gemini",
#    "cost_tier":"standard"}
# ]'

# READ THIS BEFORE SETTING.
#
# With AGENT_CONTROL_API_KEY_ENABLED=false, every operation on this server
# succeeds unauthenticated - including the ADMIN write that changes what a
# running agent does. So on such a server, saved configuration is stored and
# versioned normally but is NOT delivered: both the prompt and the model resolve
# to whatever the agent's own code declares, and the dashboard says so.
#
# This opts out, and it is for a laptop, not a deployment. It opens prompt
# delivery fully and model delivery ONLY for cost_tier "economy" entries,
# because one boolean set on day one should not be the whole distance between a
# developer's machine and an anonymous caller pointing every agent in the
# namespace at the priciest model on a personal subscription. If you need the
# premium tier locally, set AGENT_CONTROL_API_KEY_ENABLED=true with a local key.
# AGENT_CONTROL_AGENT_CONFIG_ALLOW_INSECURE_LOCAL_DEV=false

# Read by the AGENT PROCESS, not by this server. Where an openai_compatible
# managed model is called. AGENT_CONTROL_MODEL_BASE_URL and OPENAI_BASE_URL are
# co-equal - either satisfies the requirement, and the first wins when both are
# set. The control plane never sets, reads or stores either. An agent that needs
# a different endpoint runs in a different process, which the one-agent-per-
# process topology already requires.
#
# With neither set, an openai_compatible managed model is not applied at all,
# and a warning names both variables. That refusal is deliberate: applying
# without a base URL is how traffic reaches a vendor nobody chose.
# AGENT_CONTROL_MODEL_BASE_URL=http://127.0.0.1:10531/v1

# Disables the dotenv file entirely when set to the empty string, so settings
# come from the process environment and the declared defaults alone. The test
# suite sets this so a developer's local .env cannot change what tests assert.
# Deployments have no reason to set it.
# AGENT_CONTROL_SETTINGS_ENV_FILE=
