AGENT_CONTROL_URL=http://localhost:8000

# Pick ONE model route.
#
# 1. OpenAI-compatible (OpenAI itself, a local proxy, Ollama, vLLM). Set the base
#    URL here, in the executor process - the console's per-agent model picker is
#    applied by the SDK inside THIS process, so a base URL set only on the server
#    container never reaches the code that builds the client. Unset, the SDK
#    refuses every managed openai_compatible model and keeps the agent's own.
#    Either name works; AGENT_CONTROL_MODEL_BASE_URL wins if both are set.
# OPENAI_BASE_URL=http://127.0.0.1:10531/v1
# OPENAI_API_KEY=            # omit for an endpoint that authenticates upstream
# AGENT_CONTROL_DEFAULT_MODEL=gpt-5.6-sol
#
# 2. Gemini. Used only when no base URL above is set.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# Web tools (Exa, over remote MCP). On by default. No API key: the free tier is
# rate limited instead. Set to 0/false/off/no to run with no web access at all.
AGENT_CONTROL_WEB_TOOLS=1
EXA_MCP_URL=https://mcp.exa.ai/mcp

# Company knowledge, read-only. OFF by default, and the default is the point:
# with the web tools above also on, retrieval plus a free-form outbound
# argument is an egress channel - a snippet can leave inside a search query
# somebody else composed. Turning both on is a decision. See the README section
# "Company knowledge, and why it is off by default" before you do.
# AGENT_CONTROL_KNOWLEDGE_TOOLS=1

# File outputs: the agent writes a .xlsx, .docx or .pptx and uploads it to its
# own session. OFF by default. Each tool takes rows or sections, never bytes,
# and there is no tool here that reads, lists or changes a file - a draft comes
# back because the server puts it in the next turn, not because the agent
# fetched it. The upload authenticates with the per-session token, so a runaway
# loop spends its own allowance rather than every other agent's.
# AGENT_CONTROL_AGENT_FILE_OUTPUTS_ENABLED=1

# A deck to build on, so agent-written decks carry this deployment's theme,
# fonts and slide size. Unset means python-pptx's 4:3 Calibri default, which no
# designed deck looks like. Path inside the image; see brand/README.md.
AGENT_CONTROL_AGENT_FILE_TEMPLATE_PPTX=/app/examples/google_adk_plugin/brand/earlycore-template.pptx
